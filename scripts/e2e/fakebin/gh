#!/bin/sh
# Fake GitHub CLI for e2e: installed but logged out, so the setup check offers `gh auth login`.
# FAKE_GH_AUTHED=1 (a scenario's env) logs it in, with a repo, workflows and runs for the Workflows view.
# FAKE_GH_NO_WORKFLOWS=1 adds a repo without Actions: real gh prints nothing for `workflow list --json`, and [] for runs.
# FAKE_GH_MISSING=1 acts like gh isn't installed. FAKE_GH_OLD=1 rejects closingIssuesReferences like an older gh. FAKE_GH_SHIP=<dir>: the Review tab's PR and runs (below). FAKE_GH_LOG=<file> appends every call (one per line).
[ -n "$FAKE_GH_LOG" ] && echo "$*" >> "$FAKE_GH_LOG"
if [ -n "$FAKE_GH_MISSING" ]; then echo "sh: 1: gh: not found" >&2; exit 127; fi
# FAKE_GH_OLD=1: a gh from before closingIssuesReferences, which refuses the whole call when it is asked for
if [ -n "$FAKE_GH_OLD" ]; then
  case " $* " in *" --json "*closingIssuesReferences*)
    printf 'Unknown JSON field: "closingIssuesReferences"\nAvailable fields:\n  number\n  title\n' >&2; exit 1 ;;
  esac
fi
if [ -n "$FAKE_GH_NO_WORKFLOWS" ]; then
  case "$1 $2" in
    "workflow list") exit 0 ;;
    "run list") echo '[]'; exit 0 ;;
  esac
fi
# the Review tab's ship bar: FAKE_GH_SHIP=<dir> serves pr.json (the branch's PRs) and runs.json from that dir;
# `pr merge` records its arguments in merge.txt and marks the PR merged
if [ -n "$FAKE_GH_SHIP" ]; then
  [ "$1 $2 $3" = "pr list --head" ] && { cat "$FAKE_GH_SHIP/pr.json" 2>/dev/null || echo '[]'; exit 0; }
  [ "$1 $2 $3" = "run list --branch" ] && { cat "$FAKE_GH_SHIP/runs.json" 2>/dev/null || echo '[]'; exit 0; }
  if [ "$1 $2" = "pr merge" ]; then
    echo "$*" > "$FAKE_GH_SHIP/merge.txt"
    sed -i 's/"state":"OPEN"/"state":"MERGED"/' "$FAKE_GH_SHIP/pr.json"
    echo "Squashed and merged pull request #$3"; exit 0
  fi
fi
# a mission card's PR, found by the branch it was pushed from: #21, in the state pr-state.txt says
# (pr-state-<branch, / as ->.txt overrides it for one branch, so one card's PR can merge while another's stays open)
if [ "$1 $2 $3" = "pr list --head" ]; then
  f="pr-state-$(printf '%s' "$4" | tr '/' '-').txt"; [ -f "$f" ] || f=pr-state.txt
  echo "[{\"number\":21,\"state\":\"$(cat "$f" 2>/dev/null || echo OPEN)\"}]"; exit 0
fi
if [ -n "$FAKE_GH_AUTHED" ]; then
  # PR #128 in its Review tab's ship bar: state from pr-128-state.txt (OPEN), head from FAKE_GH_PR_128_HEAD, a passing
  # run on that head; a posted review is saved to review-128.json, a merge's arguments to merge-128.txt (and it merges)
  case "$1 $2 $3 $4 $5" in "pr view 128 --json number,title,state,"*)
    echo "{\"number\":128,\"title\":\"Rate limit the API\",\"state\":\"$(cat pr-128-state.txt 2>/dev/null || echo OPEN)\",\"url\":\"https://github.com/acme/shop/pull/128\",\"isDraft\":false,\"mergeable\":\"MERGEABLE\",\"mergeStateStatus\":\"CLEAN\",\"reviewDecision\":\"REVIEW_REQUIRED\",\"baseRefName\":\"main\",\"headRefOid\":\"${FAKE_GH_PR_128_HEAD:-}\",\"headRefName\":\"rate-limit\"}"; exit 0 ;;
  esac
  if [ "$1 $2 $3" = "run list --branch" ] && [ "$4" = "rate-limit" ]; then
    echo "[{\"databaseId\":801,\"displayTitle\":\"Rate limit the API\",\"workflowName\":\"CI\",\"status\":\"completed\",\"conclusion\":\"success\",\"headBranch\":\"rate-limit\",\"event\":\"pull_request\",\"createdAt\":\"2026-11-21T10:00:00Z\",\"url\":\"https://github.com/acme/shop/actions/runs/801\",\"number\":90,\"headSha\":\"${FAKE_GH_PR_128_HEAD:-}\"}]"; exit 0
  fi
  if [ "$1 $2 $3 $4" = "api --method POST repos/{owner}/{repo}/pulls/128/reviews" ]; then
    cp "$6" review-128.json; echo '{"id":1}'; exit 0
  fi
  if [ "$1 $2 $3" = "pr merge 128" ]; then
    echo "$*" > merge-128.txt; echo MERGED > pr-128-state.txt; echo "Squashed and merged pull request #128"; exit 0
  fi
  case "$1 $2" in
    "auth status") echo "Logged in to github.com as e2e"; exit 0 ;;
    "repo view") echo '{"nameWithOwner":"acme/shop","url":"https://github.com/acme/shop","defaultBranchRef":{"name":"main"},"stargazerCount":128,"forkCount":9,"issues":{"totalCount":17},"pullRequests":{"totalCount":4}}'; exit 0 ;;
    # New project → Clone: the user's repositories; acme/shop clones from FAKE_GH_REPO_URL (a local bare repo in the scenario)
    "repo list") echo "[{\"nameWithOwner\":\"acme/shop\",\"description\":\"The web shop\",\"isPrivate\":true,\"updatedAt\":\"2026-11-26T10:00:00Z\",\"url\":\"${FAKE_GH_REPO_URL:-https://github.com/acme/shop}\"},{\"nameWithOwner\":\"acme/docs\",\"description\":\"Handbook and guides\",\"isPrivate\":false,\"updatedAt\":\"2026-10-02T10:00:00Z\",\"url\":\"https://github.com/acme/docs\"},{\"nameWithOwner\":\"e2e/dotfiles\",\"description\":\"\",\"isPrivate\":false,\"updatedAt\":\"2025-06-01T10:00:00Z\",\"url\":\"https://github.com/e2e/dotfiles\"}]"; exit 0 ;;
    "release list") echo '[{"tagName":"v2.3.0","name":"Spring","publishedAt":"2026-11-01T09:00:00Z","isPrerelease":false}]'; exit 0 ;;
    "pr list")
      # the stats panel's activity chart asks for every state; FAKE_GH_ACTIVITY is the scenario's PR history
      case " $* " in *" --state all "*) echo "${FAKE_GH_ACTIVITY:-[]}"; exit 0 ;; esac
      # open PRs, with the fields of the review list; their heads are FAKE_GH_PR_<n>_HEAD (the scenario pushes refs/pull/<n>/head); FAKE_GH_PR_131_DRAFT=false makes #131 ready
      echo "[{\"number\":128,\"title\":\"Rate limit the API\",\"url\":\"https://github.com/acme/shop/pull/128\",\"isDraft\":false,\"author\":{\"login\":\"maria\",\"is_bot\":false},\"headRefName\":\"rate-limit\",\"headRefOid\":\"${FAKE_GH_PR_128_HEAD:-}\",\"baseRefName\":\"main\",\"additions\":120,\"deletions\":8,\"changedFiles\":4,\"reviewDecision\":\"CHANGES_REQUESTED\",\"reviewRequests\":[{\"__typename\":\"User\",\"login\":\"e2e\"}],\"createdAt\":\"2026-11-20T10:00:00Z\",\"updatedAt\":\"2026-11-21T10:00:00Z\",\"body\":\"Adds a limiter. Fixes #42\"},{\"number\":131,\"title\":\"Try a new cache\",\"url\":\"https://github.com/acme/shop/pull/131\",\"isDraft\":${FAKE_GH_PR_131_DRAFT:-true},\"author\":{\"login\":\"li\",\"is_bot\":false},\"headRefName\":\"cache\",\"headRefOid\":\"${FAKE_GH_PR_131_HEAD:-}\",\"baseRefName\":\"main\",\"additions\":30,\"deletions\":2,\"changedFiles\":1,\"reviewDecision\":\"\",\"reviewRequests\":[],\"createdAt\":\"2026-11-22T10:00:00Z\",\"updatedAt\":\"2026-11-22T10:00:00Z\",\"body\":\"\"}]"; exit 0 ;;
    "workflow list")
      printf '['
      for i in $(seq 1 24); do printf '{"id":%d,"name":"Job %02d","path":".github/workflows/job%d.yml","state":"active"},' "$((100 + i))" "$i" "$i"; done
      echo '{"id":1,"name":"Deploy","path":".github/workflows/deploy.yml","state":"active"}]'
      exit 0 ;;
    "run list")
      # the stats panel asks for the last 3 runs on one branch: one of each tone
      case " $* " in *" --branch "*)
        echo '[{"databaseId":701,"displayTitle":"Rate limit the API","workflowName":"CI","status":"in_progress","conclusion":"","headBranch":"main","event":"push","createdAt":"2026-11-13T10:00:00Z","url":"https://github.com/acme/shop/actions/runs/701","number":88},{"databaseId":700,"displayTitle":"Fix flaky login test","workflowName":"CI","status":"completed","conclusion":"failure","headBranch":"main","event":"push","createdAt":"2026-11-12T16:00:00Z","url":"https://github.com/acme/shop/actions/runs/700","number":87},{"databaseId":699,"displayTitle":"Bump deps","workflowName":"CI","status":"completed","conclusion":"success","headBranch":"main","event":"push","createdAt":"2026-11-12T09:00:00Z","url":"https://github.com/acme/shop/actions/runs/699","number":86}]'
        exit 0 ;;
      esac
      # the Pull requests list matches runs to PR heads: #128 failed on its head (an older commit of it passed, which
      # doesn't count), #131's only run is on a commit that isn't its head, so it has none
      case " $* " in *headSha*)
        echo "[{\"databaseId\":811,\"workflowName\":\"CI\",\"status\":\"completed\",\"conclusion\":\"failure\",\"headSha\":\"${FAKE_GH_PR_128_HEAD:-}\",\"createdAt\":\"2026-11-21T10:00:00Z\",\"event\":\"pull_request\"},{\"databaseId\":810,\"workflowName\":\"CI\",\"status\":\"completed\",\"conclusion\":\"success\",\"headSha\":\"0000000000000000000000000000000000000128\",\"createdAt\":\"2026-11-20T10:00:00Z\",\"event\":\"pull_request\"},{\"databaseId\":812,\"workflowName\":\"CI\",\"status\":\"completed\",\"conclusion\":\"success\",\"headSha\":\"0000000000000000000000000000000000000131\",\"createdAt\":\"2026-11-22T10:00:00Z\",\"event\":\"pull_request\"}]"
        exit 0 ;;
      esac
      printf '['
      for i in $(seq 1 29); do printf '{"databaseId":%d,"displayTitle":"Commit %d","workflowName":"CI","status":"completed","conclusion":"%s","headBranch":"main","event":"push","createdAt":"2026-01-02T10:00:00Z","url":"https://github.com/acme/shop/actions/runs/%d","number":%d},' "$((500 + i))" "$i" "$([ $((i % 5)) -eq 0 ] && echo failure || echo success)" "$((500 + i))" "$i"; done
      echo '{"databaseId":999,"displayTitle":"Deploy to staging","workflowName":"Deploy","status":"in_progress","conclusion":"","headBranch":"main","event":"workflow_dispatch","createdAt":"2026-01-02T11:00:00Z","url":"https://github.com/acme/shop/actions/runs/999","number":212}]'
      exit 0 ;;
    "workflow run") echo "$*" > gh-dispatch-marker.txt; exit 0 ;;
    # who is signed in (the review list's "mine" and "waiting for my review")
    "api user") echo "e2e"; exit 0 ;;
    # a PR's diff for its Review tab (FAKE_GH_LOG shows whether it was asked); FAKE_GH_PR_DIFF_REAL=1: the real one
    # from origin's refs/pull/<n>/head, as when logged out (below), so new commits show
    "pr diff")
      if [ -n "$FAKE_GH_PR_DIFF_REAL" ]; then git fetch -q origin "+refs/pull/$3/head:refs/fake-gh/pr/$3" && git diff main "refs/fake-gh/pr/$3"; exit $?; fi
      printf 'diff --git a/limiter.js b/limiter.js\nnew file mode 100644\nindex 0000000..1111111\n--- /dev/null\n+++ b/limiter.js\n@@ -0,0 +1,3 @@\n+// PR #%s\n+export const limit = 100\n+export const windowMs = 60000\n' "$3"; exit 0 ;;
  esac
  # a PR for its Review tab: title, description, head and the branches (and the issue it closes, when asked for)
  case "$1 $2 $4 $5" in "pr view --json number,title,body,url,headRefOid,headRefName,baseRefName"*)
    case "$5" in *closingIssuesReferences*) refs=',"closingIssuesReferences":[{"number":42,"url":"https://github.com/acme/shop/issues/42"}]' ;; *) refs='' ;; esac
    case "$3" in
      128) echo "{\"number\":128,\"title\":\"Rate limit the API\",\"body\":\"Adds a limiter. Fixes #42\",\"url\":\"https://github.com/acme/shop/pull/128\",\"headRefOid\":\"${FAKE_GH_PR_128_HEAD:-}\",\"headRefName\":\"rate-limit\",\"baseRefName\":\"main\"$refs}" ;;
      *) echo "{\"number\":$3,\"title\":\"Try a new cache\",\"body\":\"\",\"url\":\"https://github.com/acme/shop/pull/$3\",\"headRefOid\":\"\",\"headRefName\":\"cache\",\"baseRefName\":\"main\"}" ;;
    esac; exit 0 ;;
  esac
  # an issue a PR closes, read for its acceptance criteria
  if [ "$1 $2" = "issue view" ] && [ "$3" = "https://github.com/acme/shop/issues/42" ]; then
    printf '%s\n' '{"number":42,"title":"Too many requests","body":"Bots hammer the API.\n\n## Acceptance criteria\n- [ ] The 11th request in a minute gets a 429\n- [ ] Limits are per API key"}'; exit 0
  fi
  # one PR with the issues it closes (the review list's detail; without them when not asked, as an older gh answers)
  case "$1 $2 $3 $4 $5" in "pr view 128 --json number,title,author,"*)
    case "$5" in *closingIssuesReferences*) refs=',"closingIssuesReferences":[{"number":42,"title":"Too many requests","url":"https://github.com/acme/shop/issues/42","repository":{"name":"shop","owner":{"login":"acme"}}}]' ;; *) refs='' ;; esac
    echo "{\"number\":128,\"title\":\"Rate limit the API\",\"url\":\"https://github.com/acme/shop/pull/128\",\"isDraft\":false,\"author\":{\"login\":\"maria\"},\"headRefOid\":\"${FAKE_GH_PR_128_HEAD:-}\",\"baseRefName\":\"main\",\"body\":\"Adds a limiter. Fixes #42\"$refs}"; exit 0 ;;
  esac
  # the Review tab on a PR (gh pr view + gh pr diff): the head GitHub serves as refs/pull/<n>/head, diffed against main
  case "$1 $2 $4 $5" in "pr view --json number,title,body,url,headRefOid,headRefName,baseRefName")
    head=$(git ls-remote origin "refs/pull/$3/head" 2>/dev/null | cut -f1)
    echo "{\"number\":$3,\"title\":\"Rate limit the API\",\"body\":\"Adds a limiter. Fixes #42\",\"url\":\"https://github.com/acme/shop/pull/$3\",\"headRefOid\":\"$head\",\"headRefName\":\"rate-limit\",\"baseRefName\":\"main\"}"; exit 0 ;;
  esac
  if [ "$1 $2" = "pr diff" ]; then
    git fetch -q origin "+refs/pull/$3/head:refs/fake-gh/pr/$3" && git diff main "refs/fake-gh/pr/$3"; exit $?
  fi
  [ "$1 $2 $3" = "pr view --json" ] && { echo '{"number":128,"title":"Rate limit the API","state":"OPEN","url":"https://github.com/acme/shop/pull/128","isDraft":false,"statusCheckRollup":[{"conclusion":"SUCCESS"},{"conclusion":"SUCCESS"},{"status":"IN_PROGRESS"}]}'; exit 0; }
fi
# a pull request's state (the board moves a merged one's card to Done): pr-state.txt in the repo, OPEN without it
if [ "$1 $2 $4 $5" = "pr view --json state" ]; then
  echo "{\"state\":\"$(cat pr-state.txt 2>/dev/null || echo OPEN)\"}"; exit 0
fi
case "$1 $2" in
  "--version "*) echo "gh version 2.0.0-fake (e2e)" ;;
  "auth status") echo "You are not logged into any GitHub hosts." >&2; exit 1 ;;
  "auth login") echo "fake gh: logged in"; echo ok > gh-login-marker.txt ;;
  "issue list") echo '[{"number":42,"title":"Login button does nothing on Safari","body":"Clicking Log in on Safari 17 does nothing.","url":"https://github.com/acme/shop/issues/42","labels":[{"name":"bug"},{"name":"P1"}]},{"number":7,"title":"Add CSV export","body":"","url":"https://github.com/acme/shop/issues/7","labels":[]}]' ;;
  # the PR feedback loop: a PR, two review comments and a line comment (dates in the past)
  "pr create") echo "https://github.com/acme/shop/pull/12" ;;
  "pr view") echo '{"url":"https://github.com/acme/shop/pull/12","reviews":[{"id":"R1","author":{"login":"maria"},"body":"Looks close. Please add a test.","submittedAt":"2026-01-02T10:00:00Z","state":"CHANGES_REQUESTED"},{"id":"R2","author":{"login":"li"},"body":"","submittedAt":"2026-01-02T11:00:00Z","state":"APPROVED"}],"comments":[{"id":"C1","author":{"login":"li"},"body":"Can we keep the old log line?","createdAt":"2026-01-02T09:00:00Z","url":"https://github.com/acme/shop/pull/12#issuecomment-1"}]}' ;;
  "api repos/{owner}/{repo}/pulls/12/comments") echo '[{"id":99,"user":{"login":"maria"},"body":"Rename this variable.","created_at":"2026-01-02T10:05:00Z","html_url":"https://github.com/acme/shop/pull/12#discussion_r99","path":"src/app.js","line":1,"original_line":1}]' ;;
  *) echo "fake gh: $*" >&2; exit 1 ;;
esac
