#!/bin/sh
# Fake GitHub CLI for e2e: installed but logged out, so the setup check offers `gh auth login`.
# FAKE_GH_AUTHED=1 (a scenario's env) logs it in, with a repo, workflows and runs for the Workflows view.
# FAKE_GH_NO_WORKFLOWS=1 adds a repo without Actions: real gh prints nothing for `workflow list --json`, and [] for runs.
# FAKE_GH_MISSING=1 acts like gh isn't installed. FAKE_GH_SHIP=<dir>: the Review tab's PR and runs (below). FAKE_GH_LOG=<file> appends every call (one per line).
[ -n "$FAKE_GH_LOG" ] && echo "$*" >> "$FAKE_GH_LOG"
if [ -n "$FAKE_GH_MISSING" ]; then echo "sh: 1: gh: not found" >&2; exit 127; fi
if [ -n "$FAKE_GH_NO_WORKFLOWS" ]; then
  case "$1 $2" in
    "workflow list") exit 0 ;;
    "run list") echo '[]'; exit 0 ;;
  esac
fi
# the Review tab's ship bar: FAKE_GH_SHIP=<dir> serves pr.json (the branch's PRs) and runs.json from that dir;
# `pr merge` records its arguments in merge.txt and marks the PR merged
if [ -n "$FAKE_GH_SHIP" ]; then
  [ "$1 $2 $3" = "pr list --head" ] && { cat "$FAKE_GH_SHIP/pr.json" 2>/dev/null || echo '[]'; exit 0; }
  [ "$1 $2 $3" = "run list --branch" ] && { cat "$FAKE_GH_SHIP/runs.json" 2>/dev/null || echo '[]'; exit 0; }
  if [ "$1 $2" = "pr merge" ]; then
    echo "$*" > "$FAKE_GH_SHIP/merge.txt"
    sed -i 's/"state":"OPEN"/"state":"MERGED"/' "$FAKE_GH_SHIP/pr.json"
    echo "Squashed and merged pull request #$3"; exit 0
  fi
fi
# a mission card's PR, found by the branch it was pushed from: #21, in the state pr-state.txt says
# (pr-state-<branch, / as ->.txt overrides it for one branch, so one card's PR can merge while another's stays open)
if [ "$1 $2 $3" = "pr list --head" ]; then
  f="pr-state-$(printf '%s' "$4" | tr '/' '-').txt"; [ -f "$f" ] || f=pr-state.txt
  echo "[{\"number\":21,\"state\":\"$(cat "$f" 2>/dev/null || echo OPEN)\"}]"; exit 0
fi
if [ -n "$FAKE_GH_AUTHED" ]; then
  case "$1 $2" in
    "auth status") echo "Logged in to github.com as e2e"; exit 0 ;;
    "repo view") echo '{"nameWithOwner":"acme/shop","url":"https://github.com/acme/shop","defaultBranchRef":{"name":"main"},"stargazerCount":128,"forkCount":9,"issues":{"totalCount":17},"pullRequests":{"totalCount":4}}'; exit 0 ;;
    "release list") echo '[{"tagName":"v2.3.0","name":"Spring","publishedAt":"2026-11-01T09:00:00Z","isPrerelease":false}]'; exit 0 ;;
    "pr list")
      # the stats panel's activity chart asks for every state; FAKE_GH_ACTIVITY is the scenario's PR history
      case " $* " in *" --state all "*) echo "${FAKE_GH_ACTIVITY:-[]}"; exit 0 ;; esac
      # open PRs, with the fields of the review list; their heads are FAKE_GH_PR_<n>_HEAD (the scenario pushes refs/pull/<n>/head)
      echo "[{\"number\":128,\"title\":\"Rate limit the API\",\"url\":\"https://github.com/acme/shop/pull/128\",\"isDraft\":false,\"author\":{\"login\":\"maria\",\"is_bot\":false},\"headRefName\":\"rate-limit\",\"headRefOid\":\"${FAKE_GH_PR_128_HEAD:-}\",\"baseRefName\":\"main\",\"additions\":120,\"deletions\":8,\"changedFiles\":4,\"reviewDecision\":\"CHANGES_REQUESTED\",\"createdAt\":\"2026-11-20T10:00:00Z\",\"updatedAt\":\"2026-11-21T10:00:00Z\",\"body\":\"Adds a limiter. Fixes #42\"},{\"number\":131,\"title\":\"Try a new cache\",\"url\":\"https://github.com/acme/shop/pull/131\",\"isDraft\":true,\"author\":{\"login\":\"li\",\"is_bot\":false},\"headRefName\":\"cache\",\"headRefOid\":\"${FAKE_GH_PR_131_HEAD:-}\",\"baseRefName\":\"main\",\"additions\":30,\"deletions\":2,\"changedFiles\":1,\"reviewDecision\":\"\",\"createdAt\":\"2026-11-22T10:00:00Z\",\"updatedAt\":\"2026-11-22T10:00:00Z\",\"body\":\"\"}]"; exit 0 ;;
    "workflow list")
      printf '['
      for i in $(seq 1 24); do printf '{"id":%d,"name":"Job %02d","path":".github/workflows/job%d.yml","state":"active"},' "$((100 + i))" "$i" "$i"; done
      echo '{"id":1,"name":"Deploy","path":".github/workflows/deploy.yml","state":"active"}]'
      exit 0 ;;
    "run list")
      # the stats panel asks for the last 3 runs on one branch: one of each tone
      case " $* " in *" --branch "*)
        echo '[{"databaseId":701,"displayTitle":"Rate limit the API","workflowName":"CI","status":"in_progress","conclusion":"","headBranch":"main","event":"push","createdAt":"2026-11-13T10:00:00Z","url":"https://github.com/acme/shop/actions/runs/701","number":88},{"databaseId":700,"displayTitle":"Fix flaky login test","workflowName":"CI","status":"completed","conclusion":"failure","headBranch":"main","event":"push","createdAt":"2026-11-12T16:00:00Z","url":"https://github.com/acme/shop/actions/runs/700","number":87},{"databaseId":699,"displayTitle":"Bump deps","workflowName":"CI","status":"completed","conclusion":"success","headBranch":"main","event":"push","createdAt":"2026-11-12T09:00:00Z","url":"https://github.com/acme/shop/actions/runs/699","number":86}]'
        exit 0 ;;
      esac
      printf '['
      for i in $(seq 1 29); do printf '{"databaseId":%d,"displayTitle":"Commit %d","workflowName":"CI","status":"completed","conclusion":"%s","headBranch":"main","event":"push","createdAt":"2026-01-02T10:00:00Z","url":"https://github.com/acme/shop/actions/runs/%d","number":%d},' "$((500 + i))" "$i" "$([ $((i % 5)) -eq 0 ] && echo failure || echo success)" "$((500 + i))" "$i"; done
      echo '{"databaseId":999,"displayTitle":"Deploy to staging","workflowName":"Deploy","status":"in_progress","conclusion":"","headBranch":"main","event":"workflow_dispatch","createdAt":"2026-01-02T11:00:00Z","url":"https://github.com/acme/shop/actions/runs/999","number":212}]'
      exit 0 ;;
    "workflow run") echo "$*" > gh-dispatch-marker.txt; exit 0 ;;
  esac
  # one PR with the issues it closes (the review list's detail)
  case "$1 $2 $3 $4 $5" in "pr view 128 --json "*closingIssuesReferences*)
    echo "{\"number\":128,\"title\":\"Rate limit the API\",\"url\":\"https://github.com/acme/shop/pull/128\",\"isDraft\":false,\"author\":{\"login\":\"maria\"},\"headRefOid\":\"${FAKE_GH_PR_128_HEAD:-}\",\"baseRefName\":\"main\",\"body\":\"Adds a limiter. Fixes #42\",\"closingIssuesReferences\":[{\"number\":42,\"title\":\"Too many requests\",\"url\":\"https://github.com/acme/shop/issues/42\",\"repository\":{\"name\":\"shop\",\"owner\":{\"login\":\"acme\"}}}]}"; exit 0 ;;
  esac
  [ "$1 $2 $3" = "pr view --json" ] && { echo '{"number":128,"title":"Rate limit the API","state":"OPEN","url":"https://github.com/acme/shop/pull/128","isDraft":false,"statusCheckRollup":[{"conclusion":"SUCCESS"},{"conclusion":"SUCCESS"},{"status":"IN_PROGRESS"}]}'; exit 0; }
fi
# a pull request's state (the board moves a merged one's card to Done): pr-state.txt in the repo, OPEN without it
if [ "$1 $2 $4 $5" = "pr view --json state" ]; then
  echo "{\"state\":\"$(cat pr-state.txt 2>/dev/null || echo OPEN)\"}"; exit 0
fi
case "$1 $2" in
  "--version "*) echo "gh version 2.0.0-fake (e2e)" ;;
  "auth status") echo "You are not logged into any GitHub hosts." >&2; exit 1 ;;
  "auth login") echo "fake gh: logged in"; echo ok > gh-login-marker.txt ;;
  "issue list") echo '[{"number":42,"title":"Login button does nothing on Safari","body":"Clicking Log in on Safari 17 does nothing.","url":"https://github.com/acme/shop/issues/42","labels":[{"name":"bug"},{"name":"P1"}]},{"number":7,"title":"Add CSV export","body":"","url":"https://github.com/acme/shop/issues/7","labels":[]}]' ;;
  # the PR feedback loop: a PR, two review comments and a line comment (dates in the past)
  "pr create") echo "https://github.com/acme/shop/pull/12" ;;
  "pr view") echo '{"url":"https://github.com/acme/shop/pull/12","reviews":[{"id":"R1","author":{"login":"maria"},"body":"Looks close. Please add a test.","submittedAt":"2026-01-02T10:00:00Z","state":"CHANGES_REQUESTED"},{"id":"R2","author":{"login":"li"},"body":"","submittedAt":"2026-01-02T11:00:00Z","state":"APPROVED"}],"comments":[{"id":"C1","author":{"login":"li"},"body":"Can we keep the old log line?","createdAt":"2026-01-02T09:00:00Z","url":"https://github.com/acme/shop/pull/12#issuecomment-1"}]}' ;;
  "api repos/{owner}/{repo}/pulls/12/comments") echo '[{"id":99,"user":{"login":"maria"},"body":"Rename this variable.","created_at":"2026-01-02T10:05:00Z","html_url":"https://github.com/acme/shop/pull/12#discussion_r99","path":"src/app.js","line":1,"original_line":1}]' ;;
  *) echo "fake gh: $*" >&2; exit 1 ;;
esac
