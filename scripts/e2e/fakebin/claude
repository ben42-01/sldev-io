#!/usr/bin/env node
// Fake Claude Code for tests: fires the hooks from --settings like the real CLI and edits files.
const { spawnSync } = require('child_process'); const fs = require('fs'); const path = require('path'); const os = require('os')
const args = process.argv.slice(2)
const si = args.indexOf('--settings')
const settings = JSON.parse(fs.readFileSync(args[si + 1], 'utf8'))
const fire = (ev, payload) => spawnSync('/bin/sh', ['-c', settings.hooks[ev][0].hooks[0].command], { input: JSON.stringify({ session_id: 'sess-123', ...payload }), env: process.env, stdio: ['pipe', 'inherit', 'inherit'] })
const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms)
console.log('\x1b[35m✻ fake claude\x1b[0m  args:', args.slice(2).join(' '))
fire('SessionStart', { source: 'startup' }); sleep(400)
fire('UserPromptSubmit', { prompt: args[args.length - 1] }); sleep(400)
fire('PreToolUse', { tool_name: 'Edit', tool_input: { file_path: path.join(process.cwd(), 'src/app.js') } }); sleep(800)
fs.writeFileSync('src/app.js', "console.log('hello from mission')\nconsole.log('second line')\n"); fs.writeFileSync('NOTES.md', '# Added by mission\n')
fire('Notification', { message: 'Claude needs your permission to use Bash' }); sleep(2500)
const tp = path.join(os.tmpdir(), 'sldev-io-fake-transcript.jsonl')
fs.writeFileSync(tp, JSON.stringify({ type: 'assistant', message: { content: [{ type: 'text', text: 'Done! I updated src/app.js:1 and added NOTES.md.' }] } }) + '\n')
fire('Stop', { transcript_path: tp })
console.log('Done! I updated src/app.js:1 and added NOTES.md.')
process.stdin.resume()
