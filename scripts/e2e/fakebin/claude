#!/usr/bin/env node
// Fake Claude Code for tests: fires the hooks from --settings like the real CLI and edits files.
const { spawnSync } = require('child_process'); const fs = require('fs'); const path = require('path'); const os = require('os')
const args = process.argv.slice(2)
// the argv test reads exactly what the app passed, to prove the prompt arrives as one argument
if (process.env.SLDEV_E2E_ARGV) fs.appendFileSync(process.env.SLDEV_E2E_ARGV, JSON.stringify(args) + '\n')
const si = args.indexOf('--settings')
const settings = JSON.parse(fs.readFileSync(args[si + 1], 'utf8'))
// the hook command through the platform's shell, like the real CLI (sh here, cmd.exe on Windows)
const fire = (ev, payload) => spawnSync(settings.hooks[ev][0].hooks[0].command, { shell: true, input: JSON.stringify({ session_id: 'sess-123', ...payload }), env: process.env, stdio: ['pipe', 'inherit', 'inherit'] })
const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms)
console.log('\x1b[35m✻ fake claude\x1b[0m  args:', args.slice(2).join(' '))
// HIT_LIMIT: stop at the plan's usage limit like the real CLI (print mode exits with an error, interactive waits)
if (args[args.length - 1].includes('HIT_LIMIT')) {
  fire('SessionStart', { source: 'startup' }); sleep(300)
  fs.appendFileSync('PARTIAL.md', 'half done by claude\n')
  console.log('Claude usage limit reached. Your limit will reset at 3pm (Europe/Berlin).')
  if (args.includes('-p')) process.exit(1)
  process.stdin.resume()
  return
}
// print mode (-p), as the factory runs it: do the work, write the output file it was asked for, exit
if (args.includes('-p')) {
  const prompt = args[args.length - 1]
  fire('SessionStart', { source: 'startup' }); sleep(300)
  fire('UserPromptSubmit', { prompt }); sleep(300)
  // a long step, so the pipeline can show what a stage is doing while it runs
  if (prompt.includes('SLOW_STEP')) { fire('PreToolUse', { tool_name: 'Bash', tool_input: { command: 'npm test', description: 'Run the test suite' } }); sleep(4000) }
  // the last run file in the prompt is this step's own output; earlier ones are inputs
  const out = [...prompt.matchAll(/(\/\S+?\.sldev\/runs\/\S+?\.md)/g)].pop()
  const mi = args.indexOf('--mcp-config')
  if (mi >= 0 && prompt.includes('USE_MCP')) {
    // like the real CLI: start the configured stdio server and call its tools
    const { command, args: sargs, env } = JSON.parse(args[mi + 1]).mcpServers.sldev
    const rpc = (id, method, params) => JSON.stringify({ jsonrpc: '2.0', id, method, params })
    const call = (id, name, a) => rpc(id, 'tools/call', { name, arguments: a })
    const input = [rpc(1, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'fake-claude', version: '0' } }),
      call(2, 'sldev_status', { state: 'needs_input', message: 'Which database should I use?' })].join('\n') + '\n'
    const r1 = spawnSync(command, sargs, { input, env: { ...process.env, ...env }, encoding: 'utf8' })
    console.log('mcp:', r1.stdout.trim().split('\n').length, 'replies')
    sleep(1500)
    const input2 = [call(3, 'sldev_status', { state: 'working', message: 'Using Postgres' }),
      call(4, 'sldev_output', { markdown: '# Spec via MCP\n\nUse Postgres.\n' })].join('\n') + '\n'
    spawnSync(command, sargs, { input: input2, env: { ...process.env, ...env }, encoding: 'utf8' })
  } else if (mi >= 0 && prompt.includes('BOARD_MCP')) {
    // files follow-up work on the board, like an agent that found something it shouldn't fix now
    const { command, args: sargs, env } = JSON.parse(args[mi + 1]).mcpServers.sldev
    const rpc = (id, method, params) => JSON.stringify({ jsonrpc: '2.0', id, method, params })
    const input = [rpc(1, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'fake-claude', version: '0' } }),
      rpc(2, 'tools/call', { name: 'sldev_board_add', arguments: { title: 'Add tests for the health check', details: 'src/health.js has no tests.', labels: ['tests'], priority: 'high' } })].join('\n') + '\n'
    spawnSync(command, sargs, { input, env: { ...process.env, ...env }, encoding: 'utf8' })
  }
  // an eval's judge: a verdict in the file it was given (JUDGE_FAIL in the rubric fails it)
  if (out && prompt.startsWith('Judge:')) { fs.mkdirSync(path.dirname(out[1]), { recursive: true }); fs.writeFileSync(out[1], prompt.includes('JUDGE_FAIL') ? 'VERDICT: FAIL\nNo test for it.\n' : 'VERDICT: PASS\nThe change does what the rubric asks.\n'); fire('Stop', {}); process.exit(0) }
  if (out && !prompt.includes('NO_OUTPUT') && !prompt.includes('USE_MCP')) { fs.mkdirSync(path.dirname(out[1]), { recursive: true }); fs.writeFileSync(out[1], `# Output from fake claude\n\n${prompt.split('\n')[0]}\n`) }
  const note = /From the user: (.*)/.exec(prompt)
  if (note) fs.appendFileSync('USER-NOTES.md', `${note[1]}\n`)
  // NO_CHANGES: a repeat pass with nothing left to improve
  if (!prompt.includes('NO_CHANGES')) fs.appendFileSync(out ? `changes-${path.basename(out[1], '.md')}.md` : 'CHANGES.md', `claude: ${prompt.split('\n')[0]}\n`)
  sleep(800)
  fire('Stop', {})
  console.log('done (print mode)')
  process.exit(0)
}
const ip = args[args.length - 1]
// a Lead: plan, delegate to two agents, wait for both, review a diff, integrate with a check, report
if (ip.startsWith('Lead:')) {
  fire('SessionStart', { source: 'startup' }); sleep(300)
  fire('UserPromptSubmit', { prompt: ip }); sleep(600)
  const mi = args.indexOf('--mcp-config')
  const { command, args: sargs, env } = JSON.parse(args[mi + 1]).mcpServers.sldev
  const rpc = (id, method, params) => JSON.stringify({ jsonrpc: '2.0', id, method, params })
  const tools = (...calls) => {
    const input = [rpc(1, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'fake-lead', version: '0' } }), ...calls.map(([name, a], n) => rpc(2 + n, 'tools/call', { name, arguments: a }))].join('\n') + '\n'
    const r = spawnSync(command, sargs, { input, env: { ...process.env, ...env }, encoding: 'utf8', timeout: 240000 })
    return r.stdout.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l) } catch { return null } }).filter((x) => x && x.id >= 2).sort((a, b) => a.id - b.id).map((x) => x.result?.content?.[0]?.text ?? x.error?.message ?? '')
  }
  const started = tools(
    ['sldev_delegate', { title: 'Write the changelog note', brief: 'Note the change in CHANGES.md.', criteria: '- CHANGES.md says what changed', agent: 'claude' }],
    ['sldev_delegate', { title: 'Codex part', brief: 'Leave your mark in CODEX.md.', agent: 'codex' }]
  )
  console.log('lead:', started.join(' | '))
  const ids = started.map((t) => (/Started (m-\w+)/.exec(t) || [])[1]).filter(Boolean)
  let waited = ''
  for (let i = 0; i < 8 && ids.length; i++) {
    const t = tools(['sldev_wait', { seconds: 20 }])[0] || ''
    waited += t
    if (!t.includes('Still running')) break
  }
  fs.writeFileSync(path.join(os.tmpdir(), `sldev-io-fake-lead-${process.pid}.txt`), waited)
  const review = ids.length ? tools(['sldev_mission_diff', { id: ids[0] }])[0] : ''
  const merged = ids.length ? tools(['sldev_integrate', { ids, check: "node -e \"require('fs').statSync('CHANGES.md'); require('fs').statSync('CODEX.md')\"" }])[0] : 'nothing'
  console.log('lead review:', (review || '').split('\n')[0])
  console.log('lead merged:', merged)
  const tp = path.join(os.tmpdir(), `sldev-io-fake-transcript-${process.pid}.jsonl`)
  fs.writeFileSync(tp, JSON.stringify({ type: 'assistant', message: { content: [{ type: 'text', text: `Lead summary: ${ids.length} workers. ${merged.replace(/\n/g, '; ')}` }] } }) + '\n')
  fire('Stop', { transcript_path: tp })
  console.log('Lead done.')
  process.stdin.resume()
  return
}
// story writing (the board's Write stories / Refine): file stories through the sldev tools, or into the file the prompt names
if (ip.startsWith('Write stories:') || ip.startsWith('Refine card #')) {
  fire('SessionStart', { source: 'startup' }); sleep(300)
  fire('UserPromptSubmit', { prompt: ip }); sleep(1200)
  const refine = /^Refine card #(\d+)/.exec(ip)
  const stories = refine
    ? [{ title: 'Cache the session lookup on login', details: '**Why** Login waits on two queries.\n\n**Acceptance criteria**\n- [ ] one query per login', labels: ['perf', 'api'], priority: 'high' }]
    : [
        { title: 'Create a team', details: '**Why** Teams share projects.\n\n**What to do** src/teams.js\n\n**Acceptance criteria**\n- [ ] POST /teams creates one\n\n**How to check** npm test', labels: ['feature', 'api'], priority: 'high' },
        { title: 'Invite people by email', details: '**Acceptance criteria**\n- [ ] an invite link works once', labels: ['feature'], priority: 'normal' },
        { title: 'Remove a member', details: '**Acceptance criteria**\n- [ ] only owners can', labels: ['feature', 'auth'], priority: 'low' }
      ]
  const file = /JSON array to (\S+) \(the one file you may create\)/.exec(ip)
  const mi = args.indexOf('--mcp-config')
  if (file) {
    fs.mkdirSync(path.dirname(file[1]), { recursive: true })
    fs.writeFileSync(file[1], JSON.stringify(stories))
  } else if (mi >= 0) {
    const { command, args: sargs, env } = JSON.parse(args[mi + 1]).mcpServers.sldev
    const rpc = (id, method, params) => JSON.stringify({ jsonrpc: '2.0', id, method, params })
    const calls = refine
      ? [rpc(2, 'tools/call', { name: 'sldev_board_update', arguments: { key: Number(refine[1]), ...stories[0] } })]
      : stories.map((st, n) => rpc(2 + n, 'tools/call', { name: 'sldev_board_add', arguments: st }))
    const input = [rpc(1, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'fake-claude', version: '0' } }), ...calls].join('\n') + '\n'
    spawnSync(command, sargs, { input, env: { ...process.env, ...env }, encoding: 'utf8' })
  }
  sleep(600)
  const tp = path.join(os.tmpdir(), `sldev-io-fake-transcript-${process.pid}.jsonl`)
  fs.writeFileSync(tp, JSON.stringify({ type: 'assistant', message: { content: [{ type: 'text', text: `Wrote ${stories.length} stories.` }] } }) + '\n')
  fire('Stop', { transcript_path: tp })
  console.log(`Wrote ${stories.length} stories.`)
  process.stdin.resume()
  return
}
fire('SessionStart', { source: 'startup' }); sleep(400)
fire('UserPromptSubmit', { prompt: args[args.length - 1] }); sleep(400)
fire('PreToolUse', { tool_name: 'Edit', tool_input: { file_path: path.join(process.cwd(), 'src/app.js') } }); sleep(800)
fs.writeFileSync('src/app.js', "console.log('hello from mission')\nconsole.log('second line')\n"); fs.writeFileSync('NOTES.md', '# Added by mission\n')
fire('Notification', { message: 'Claude needs your permission to use Bash' }); sleep(2500)
const tp = path.join(os.tmpdir(), `sldev-io-fake-transcript-${process.pid}.jsonl`)
const reply = (text) => JSON.stringify({ type: 'assistant', message: { content: [{ type: 'text', text }] } }) + '\n'
if (args[args.length - 1].includes('LATE_REPLY')) {
  // the real CLI sometimes writes its last reply just after the Stop hook fires: the hook only sees a tool call
  fs.writeFileSync(tp, JSON.stringify({ type: 'assistant', message: { content: [{ type: 'tool_use', name: 'ExitPlanMode', input: {} }] } }) + '\n')
  fire('Stop', { transcript_path: tp })
  sleep(300)
  fs.appendFileSync(tp, reply('Findings: the parser allocates per token. Fix: reuse one buffer.'))
} else {
  fs.writeFileSync(tp, reply('Done! I updated src/app.js:1 and added NOTES.md.'))
  fire('Stop', { transcript_path: tp })
}
console.log('Done! I updated src/app.js:1 and added NOTES.md.')
process.stdin.resume()
