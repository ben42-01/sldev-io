{
  "name": "sldev-io",
  "productName": "sldev-io",
  "desktopName": "sldev-io.desktop",
  "version": "1.0.2",
  "description": "Agentic coding workspace: terminals, agents, runtimes, skills, workflows.",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "author": {
    "name": "sldev-io",
    "email": "team.agora.hub@gmail.com"
  },
  "homepage": "https://github.com/ben42-01/sldev-io",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:nosandbox": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p cli/tsconfig.json",
    "cli:build": "vite build --config cli/vite.config.mts",
    "cli:pack": "npm run cli:build && mkdir -p dist && npm pack ./cli --pack-destination dist",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "gh-stats": "bash scripts/gh-stats.sh",
    "e2e": "npm run build && electron --no-sandbox scripts/e2e/run.cjs",
    "website": "npm --prefix website run dev -- --open",
    "website:build": "npm --prefix website run build",
    "promo": "npm --prefix marketing/promo run studio"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "node-pty": "1.1.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "dockview": "8.6.1",
    "dockview-react": "8.6.1",
    "dompurify": "3.4.17",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben42-01/sldev-io.git"
  }
}
