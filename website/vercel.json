{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/cli",
      "destination": "/cli/index.html"
    },
    {
      "source": "/cli/commands",
      "destination": "/cli/commands/index.html"
    },
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/features",
      "destination": "/features/index.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog/index.html"
    },
    {
      "source": "/compare",
      "destination": "/compare/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/:page",
      "destination": "/docs/:page/index.html"
    },
    {
      "source": "/download/:os",
      "destination": "/api/download?os=:os"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/app#free",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/refunds",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/thanks",
      "destination": "/",
      "permanent": true
    }
  ]
}
